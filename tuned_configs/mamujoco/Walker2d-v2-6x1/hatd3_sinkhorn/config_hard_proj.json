{
    "algo_args": {
      "algo": {
        "batch_size": 512,
        "buffer_size": 1000000,
        "expl_noise": 0.1,
        "fixed_order": false,
        "gamma": 0.99,
        "n_step": 25,
        "noise_clip": 0.5,
        "policy_freq": 2,
        "policy_noise": 0.2,
        "polyak": 0.005,
        "share_param": false,
        "max_grad_norm": 10.0,
        "sinkhorn": {
          "enabled": true,
          "mode": "projection",
          "lam": 1.0,
          "radius": 0.15,
          "dual_lr": 0.01,
          "p": 2,
          "blur": 0.10,          
          "scaling": 0.8,        
          "backend": "auto",
          "weighted_marginals": false,
          "ground_metric": "euclidean",
          "ground_metric_diag": null,
          "ls_step": 20,
          "accept_ratio": 0.4,
          "backtrack_coeff": 0.9,
          "step_size": 0.2
        }
      },
      "device": {
        "cuda": true,
        "cuda_deterministic": true,
        "torch_threads": 4
      },
      "eval": {
        "eval_episodes": 40,
        "n_eval_rollout_threads": 20,
        "use_eval": true
      },
      "logger": {
        "log_dir": "./results"
      },
      "model": {
        "activation_func": "relu",
        "critic_lr": 0.001,
        "final_activation_func": "tanh",
        "hidden_sizes": [256, 256],
        "lr": 0.0005
      },
      "render": {
        "render_episodes": 10,
        "use_render": false
      },
      "seed": {
        "seed": 1,
        "seed_specify": true
      },
      "train": {
        "eval_interval": 10000,
        "log_interval": null,
        "model_dir": null,
        "n_rollout_threads": 10,
        "num_env_steps": 10000000,
        "train_interval": 50,
        "update_per_train": 1,
        "use_linear_lr_decay": false,
        "use_proper_time_limits": true,
        "warmup_steps": 10000
      }
    },
    "env_args": {
      "agent_conf": "6x1",
      "agent_obsk": 0,
      "episode_limit": 1000,
      "scenario": "Walker2d-v2"
    },
    "main_args": {
      "algo": "hatd3_sinkhorn",
      "env": "mamujoco",
      "exp_name": "report_dual_sinkhorn",
      "load_config": ""
    }
  }
  